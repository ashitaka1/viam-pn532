{
  "$schema": "https://dl.viam.dev/module.schema.json",
  "module_id": "avery:nfc-pn532",
  "visibility": "public",
  "url": "https://github.com/ashitaka1/viam-pn532",
  "description": "NXP PN532 NFC/RFID reader sensor supporting tag detection and NDEF read over UART, I2C, and SPI transports",
  "markdown_link": "README.md",
  "entrypoint": "bin/pn532",
  "first_run": "",
  "models": [
    {
      "api": "rdk:component:sensor",
      "model": "avery:nfc:pn532"
    }
  ],
  "build": {
    "build": "make module.tar.gz",
    "setup": "make setup",
    "path": "module.tar.gz",
    "arch": [
      "linux/amd64",
      "linux/arm64",
      "darwin/arm64"
    ]
  }
}
